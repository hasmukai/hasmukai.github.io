---
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile, socialLinks } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  section?: 'profile' | 'blog';
  description?: string;
}
const { title, section = 'profile', description = `${profile.name}のポートフォリオ。${profile.bio}。` } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const key = 'hasmukai-theme';
        let theme = null;
        try { theme = localStorage.getItem(key); } catch { /* Storage may be unavailable. */ }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f151b' : '#ffffff');
      })();
    </script>
    <link rel="icon" type="image/jpeg" href={profile.avatar} />
    <title>{title} / Hasmukai</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="site-shell">
      <header class="sidebar">
        <div class="sidebar-inner">
          <a class="brand" href="/" aria-label="Hasmukai ホーム">
            <span class="brand-mark">h<span>.</span></span>
            <span class="brand-caption">PERSONAL<br />PORTFOLIO</span>
          </a>
          <nav class="navigation" aria-label="メインナビゲーション">
            <a href="/" class:list={['nav-item', { active: section === 'profile' }]} aria-label="プロフィール" aria-current={section === 'profile' ? 'page' : undefined}>
              <Icon name="profile" /><span>プロフィール</span>
            </a>
            <button class="nav-item search-button" type="button" aria-label="検索" aria-disabled="true">
              <Icon name="search" /><span>検索</span>
            </button>
            <a href="/blog/" class:list={['nav-item', { active: section === 'blog' }]} aria-label="ブログ" aria-current={section === 'blog' ? 'page' : undefined}>
              <Icon name="blog" /><span>ブログ</span>
            </a>
          </nav>
          <div class="sidebar-bottom">
            <a href="/" class="mini-profile" aria-label="Hasmukaiのプロフィール">
              <img src={profile.avatar} alt="" width="42" height="42" />
              <span><strong>Hasmukai</strong><span>Personal portfolio</span></span>
            </a>
            <p class="sidebar-note">A little corner of the internet.</p>
          </div>
        </div>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <aside class="right-sidebar" aria-label="関連リンク">
        <div class="right-inner">
          <div class="side-heading"><span class="status-dot"></span> MY CORNER OF THE WEB<ThemeToggle /></div>
          <section class="links-panel">
            <div class="panel-heading"><h2>リンク</h2><Icon name="link" size={18} /></div>
            {socialLinks.map(link => (
              <a class="social-row" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.name} ${link.handle}（新しいタブで開く）`}>
                <span class:list={['social-logo', link.icon]}><Icon name={link.icon} size={21} /></span>
                <span class="social-text"><strong>{link.name}</strong><span>{link.handle}</span></span>
                <Icon name="external" size={17} />
              </a>
            ))}
          </section>
          <a href="/blog/" class="blog-callout">
            <span class="callout-top"><Icon name="blog" size={23} /><span>THE BLOG</span></span>
            <h2>ブログ一覧</h2>
            <span class="callout-link">ブログを読む <Icon name="arrow" size={18} /></span>
            <span class="callout-decoration" aria-hidden="true"></span>
          </a>
          <footer class="site-footer"><span>© {new Date().getFullYear()} Hasmukai</span><span>Made with curiosity.</span></footer>
        </div>
      </aside>
    </div>

<script>
  const STORAGE_KEY = 'hasmukai-theme';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));

  type Theme = 'light' | 'dark';

  const readStoredTheme = (): Theme | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  };

  const applyTheme = (theme: Theme, persist: boolean) => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    if (meta) meta.content = theme === 'dark' ? '#0f151b' : '#ffffff';
    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        /* Keep the current session usable when storage is unavailable. */
      }
    }
    const label = theme === 'dark' ? 'ライトモードに切り替える' : 'ダークモードに切り替える';
    buttons.forEach(button => {
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    });
  };

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
    });
  });

  media.addEventListener('change', event => {
    if (readStoredTheme()) return;
    applyTheme(event.matches ? 'dark' : 'light', false);
  });

  window.addEventListener('storage', event => {
    if (event.key !== STORAGE_KEY) return;
    const stored = readStoredTheme();
    applyTheme(stored ?? (media.matches ? 'dark' : 'light'), false);
  });

  applyTheme(readStoredTheme() ?? (media.matches ? 'dark' : 'light'), false);
</script>
  </body>
</html>

