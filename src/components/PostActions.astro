---
import Icon from './Icon.astro';
---
<div class="post-actions" aria-label="投稿の操作">
  <span aria-label="返信"><Icon name="reply" size={19} /></span>
  <span aria-label="リポスト"><Icon name="repost" size={19} /></span>
  <button type="button" class="like-button" aria-label="いいね" aria-pressed="false"><Icon name="heart" size={19} /></button>
  <span aria-label="統計"><Icon name="stats" size={19} /></span>
</div>
