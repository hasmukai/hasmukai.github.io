---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PostCard from '../components/PostCard.astro';
import PostActions from '../components/PostActions.astro';
import { profile, socialLinks } from '../data/profile';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---

<SiteLayout title="プロフィール">
  <header class="page-header">
    <div><p class="header-title">Hasmukai<span class="blue-period">.</span></p><p class="header-subtitle">プロフィール</p></div>
    <div class="header-actions"><span class="header-label">PORTFOLIO</span><ThemeToggle class="theme-toggle--header" /></div>
  </header>
  <section aria-label="プロフィール">
    <div class="cover" aria-hidden="true">
      <div class="cover-grid"></div>
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="cover-sphere"></div>
      <span class="cover-spark spark-one">✦</span><span class="cover-spark spark-two">✦</span>
      <span class="cover-caption">A SPACE FOR MY THOUGHTS</span><span class="cover-corner">01 / ∞</span>
    </div>
    <div class="profile-details">
      <div class="profile-topline">
        <img class="profile-avatar" src={profile.avatar} alt="Hasmukaiのアイコン" width="132" height="132" fetchpriority="high" />
        <a class="outline-button" href="https://x.com/suraimusan2" target="_blank" rel="noopener noreferrer" aria-label="Xで見る（新しいタブで開く）"><Icon name="x" size={15} /> Xで見る <Icon name="external" size={16} /></a>
      </div>
      <h1>{profile.name}</h1><p class="profile-bio">{profile.bio}</p>
      <div class="profile-links" aria-label="外部プロフィール">
        <Icon name="link" size={17} />
        {socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.name}（新しいタブで開く）`}>{link.name}<Icon name="external" size={13} /></a>)}
      </div>
    </div>
  </section>
  <nav class="feed-tabs" aria-label="コンテンツ">
    <button type="button" class="selected" data-feed="timeline" aria-pressed="true"><span>タイムライン</span></button>
    <button type="button" data-feed="likes" aria-pressed="false"><span>いいね</span></button>
  </nav>
  <section class="timeline" aria-label="タイムライン">
    {[
      { id: "signate-student-cup-2026", date: "2026-09-16", label: "2026.09.16", text: " で精度賞2位、プレゼン賞1位を取りました！", link: "https://user.competition.signate.jp/ja/competition/detail/?competition=54ee8a27750e4c8cb053d3aec3e2cebf", linkText: "SIGNATE × TECH OCEAN Student Cup 2026" },
      { id: "toeic-2026-07-02", date: "2026-07-02", label: "2026.07.02", text: "TOEIC L&R Testで825点をとりました！" },
      { id: "drivers-license-2025-10-15", date: "2025-10-15", label: "2025.10.15", text: "普通自動車運転免許を取得しました！" },
      { id: "tokyo-tech-2023-04-01", date: "2023-04-01", label: "2023.04.01", text: "東京工業大学情報理工学院に入学しました！" },
    ].map(item => (
      <article class="post timeline-post" data-post-id={item.id}>
        <img class="post-avatar" src={profile.avatar} alt="" width="40" height="40" />
        <div class="post-content"><div class="post-meta"><strong>{profile.shortName}</strong><time datetime={item.date}>{item.label}</time></div><p>{item.link && <a href={item.link}>{item.linkText}</a>}{item.text}</p><PostActions /></div>
      </article>
    ))}
    {posts.map(post => <PostCard post={post} timeline />)}
    <p class="likes-empty" hidden>いいねした投稿はまだありません。</p>
    <div class="feed-end"><span></span><span>You're all caught up.</span><span></span></div>
  </section>
  <script>
    const key = 'hasmukai-liked-posts';
    let likes: string[] = [];
    try {
      const saved = JSON.parse(localStorage.getItem(key) || '[]');
      if (Array.isArray(saved)) likes = saved.filter((id): id is string => typeof id === 'string');
    } catch { /* Storage may be unavailable or contain invalid data. */ }
    let feed = 'timeline';
    const cards = document.querySelectorAll<HTMLElement>('.timeline-post[data-post-id]');
    const render = () => {
      cards.forEach(card => {
        const liked = likes.includes(card.dataset.postId || '');
        card.hidden = feed === 'likes' && !liked;
        card.querySelector('.like-button')?.setAttribute('aria-pressed', String(liked));
      });
      const empty = document.querySelector<HTMLElement>('.likes-empty');
      if (empty) empty.hidden = feed !== 'likes' || Array.from(cards).some(card => !card.hidden);
      document.querySelectorAll<HTMLButtonElement>('[data-feed]').forEach(tab => {
        const selected = tab.dataset.feed === feed;
        tab.classList.toggle('selected', selected);
        tab.setAttribute('aria-pressed', String(selected));
      });
    };
    cards.forEach(card => card.querySelector('.like-button')?.addEventListener('click', () => {
      const id = card.dataset.postId!;
      likes = likes.includes(id) ? likes.filter(item => item !== id) : [...likes, id];
      try { localStorage.setItem(key, JSON.stringify(likes)); } catch { /* Keep the current session usable. */ }
      render();
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-feed]').forEach(tab => tab.addEventListener('click', () => { feed = tab.dataset.feed || 'timeline'; render(); }));
    window.addEventListener('storage', event => {
      if (event.key !== key) return;
      try { const saved = JSON.parse(event.newValue || '[]'); likes = Array.isArray(saved) ? saved.filter((id): id is string => typeof id === 'string') : []; } catch { likes = []; }
      render();
    });
    render();
  </script>
</SiteLayout>
